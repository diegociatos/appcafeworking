DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Módulo de Boletos — front-end (Vite). Usado por src/lib/boletosApi.js.
# Sem isto, a tela de Boletos roda em modo demonstração (store local).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend (Edge Functions) — configurar via `supabase secrets set`, NUNCA no front:
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Notificações por e-mail (Resend) — secrets do backend:
# RESEND_API_KEY=
# EMAIL_FROM="CafeWorking <nao-responda@grupociatos.com.br>"
# EMAIL_REPLY_TO=
# APP_URL=https://app.cafeworking.com.br
